  { id:'q104', text:'LLaMA is an AI model released by…?', options:['Apple','Amazon','Twitter','Meta'], correctIndex:3, correctAnswer:'Meta', why:'Meta\'s LLaMA (Large Language Model Meta AI) is an open-weight LLM family.', category:'genai' },
  { id:'q105', text:'An AI "agent" can do what a chatbot cannot?', options:['Print on paper','Speak faster','Take real-world actions','Be colourful'], correctIndex:2, correctAnswer:'Take real-world actions', why:'Agents use tools (web search, code execution, APIs) to complete multi-step tasks.', category:'genai' },
  // ── ETHICS ────────────────────────────────────────────────────────
  { id:'q106', text:'Recommendation feeds can create…?', options:['Filter bubbles','Thunder','Rainbows','Snow'], correctIndex:0, correctAnswer:'Filter bubbles', why:'Filter bubbles occur when algorithms only show content matching your existing views.', category:'ethics' },
  { id:'q107', text:'AI surveillance can raise concerns about…?', options:['Internet speed','Electricity cost','Screen size','Privacy'], correctIndex:3, correctAnswer:'Privacy', why:'Mass AI surveillance can infringe on civil liberties and personal privacy.', category:'ethics' },
  { id:'q108', text:'AI-written text should be…?', options:['Eaten','Framed','Never read','Checked by a human'], correctIndex:3, correctAnswer:'Checked by a human', why:'AI text can contain errors, biases, or hallucinations — human review is essential.', category:'ethics' },
  { id:'q109', text:'Relying only on AI for medical advice is…?', options:['Required','Not wise','Perfectly safe','Free'], correctIndex:1, correctAnswer:'Not wise', why:'AI is not a licensed medical professional and can make dangerous mistakes.', category:'ethics' },
  { id:'q110', text:'AI can accidentally repeat human…?', options:['Haircuts','Lunches','Biases','Shoes'], correctIndex:2, correctAnswer:'Biases', why:'Historical data encodes societal biases that AI models can amplify.', category:'ethics' },
  // ── WORK ────────────────────────────────────────────────────────
  { id:'q111', text:'AI can summarise a meeting into…?', options:['A painting','A meal','A song','Notes'], correctIndex:3, correctAnswer:'Notes', why:'Tools like Microsoft Copilot and Otter.ai transcribe and summarise meetings.', category:'work' },
  { id:'q112', text:'AI code assistants can…?', options:['Order parts','Design buildings','Fix the hardware','Explain what code does'], correctIndex:3, correctAnswer:'Explain what code does', why:'Copilot, CodeWhisperer, and similar tools can explain, generate, and debug code.', category:'work' },
  { id:'q113', text:'AI can translate a document in…?', options:['Months','Years','Weeks','Seconds'], correctIndex:3, correctAnswer:'Seconds', why:'Neural machine translation can translate thousands of words in under a second.', category:'work' },
  { id:'q114', text:'"AIOps" uses AI to manage…?', options:['Traffic lights','Water pipes','IT operations','Kitchen appliances'], correctIndex:2, correctAnswer:'IT operations', why:'AIOps applies ML to automate incident detection, root-cause analysis, and resolution.', category:'work' },
  { id:'q115', text:'AI can extract data from invoices…?', options:['Only manually','Automatically','Never','In weeks'], correctIndex:1, correctAnswer:'Automatically', why:'Intelligent Document Processing (IDP) uses OCR + ML to extract invoice data at scale.', category:'work' },
  // ── BASIC ────────────────────────────────────────────────────────
  { id:'q116', text:'AI works with no electricity at all?', options:['Sometimes','False','Always','True'], correctIndex:1, correctAnswer:'False', why:'AI requires computers and servers — all of which need electricity to operate.', category:'basic' },
  { id:'q117', text:'AI understands you exactly like a human friend?', options:['No','Only teachers','Yes fully','Only family'], correctIndex:0, correctAnswer:'No', why:'AI processes language statistically — it has no real understanding or empathy.', category:'basic' },
  { id:'q118', text:'AI can make mistakes?', options:['Never','Only in winter','Yes','Only if old'], correctIndex:2, correctAnswer:'Yes', why:'All AI systems have error rates — some small, some large depending on the task.', category:'basic' },
  // ── ETHICS ────────────────────────────────────────────────────────
  { id:'q119', text:'Which is NOT something AI currently does?', options:['Translate text','Feel real love','Suggest songs','Spot spam'], correctIndex:1, correctAnswer:'Feel real love', why:'AI has no feelings, consciousness, or emotions — it simulates them with language.', category:'ethics' },
  // ── BASIC ────────────────────────────────────────────────────────
  { id:'q120', text:'Which is NOT needed to train AI?', options:['Examples','Data','Computers','A wizard'], correctIndex:3, correctAnswer:'A wizard', why:'You need data, compute, and algorithms — no magic required!', category:'basic' },
  { id:'q121', text:'A chatbot chat is with a…?', options:['Real stranger always','Ghost','Computer program','Robot toy'], correctIndex:2, correctAnswer:'Computer program', why:'Even human-like chatbots are software programs, not people.', category:'basic' },
  { id:'q122', text:'Which is a smart everyday AI?', options:['Autocorrect','A spoon','A brick','A doorknob'], correctIndex:0, correctAnswer:'Autocorrect', why:'Autocorrect uses statistical language models — one of the earliest consumer AI apps.', category:'basic' },
  { id:'q123', text:'AI spam detection keeps your inbox…?', options:['Heavier','Louder','Cleaner','Colder'], correctIndex:2, correctAnswer:'Cleaner', why:'ML classifiers trained on spam/ham emails filter out unwanted messages automatically.', category:'basic' },
  { id:'q124', text:'Voice typing (speech to text) is…?', options:['Photosynthesis','Speech recognition AI','Encryption','Charging'], correctIndex:1, correctAnswer:'Speech recognition AI', why:'ASR (Automatic Speech Recognition) converts spoken audio to text using deep learning.', category:'basic' },
  { id:'q125', text:'Which is a voice assistant?', options:['A mop','A frying pan','Google Assistant','A ladder'], correctIndex:2, correctAnswer:'Google Assistant', why:'Google Assistant is Google\'s AI-powered voice assistant available on Android and smart home devices.', category:'basic' },
  // ── GENAI ────────────────────────────────────────────────────────
  { id:'q126', text:'Which is made by generative AI?', options:['AI art','A real tree','A river','A mountain'], correctIndex:0, correctAnswer:'AI art', why:'AI art is generated by models like Midjourney, DALL-E, or Stable Diffusion from text prompts.', category:'genai' },
  { id:'q127', text:'A more detailed prompt often gives a…?', options:['Worse result','Colder result','Better result','Louder result'], correctIndex:2, correctAnswer:'Better result', why:'Specificity in prompts reduces ambiguity and guides the model to more useful outputs.', category:'genai' },
  // ── ETHICS ────────────────────────────────────────────────────────
  { id:'q128', text:'AI is best used to…?', options:['Do nothing','Break rules','Help people','Replace all thinking'], correctIndex:2, correctAnswer:'Help people', why:'AI is a tool — used responsibly, it amplifies human capability without replacing human judgement.', category:'ethics' },
  // ── BASIC ────────────────────────────────────────────────────────
  { id:'q129', text:'Without data to learn from, an AI…?', options:['Struggles','Sleeps','Improves','Sings'], correctIndex:0, correctAnswer:'Struggles', why:'Data is the fuel for AI — without quality training data, models cannot learn effectively.', category:'basic' },
  { id:'q130', text:'AI models are stored on…?', options:['Stone tablets','Computers and servers','Cloth','Paper'], correctIndex:1, correctAnswer:'Computers and servers', why:'AI models are software artefacts stored in files (weights) on servers or local drives.', category:'basic' },
  // ── GENAI ────────────────────────────────────────────────────────
  { id:'q131', text:'Text-to-image AI turns words into…?', options:['Songs','Pictures','Coins','Smells'], correctIndex:1, correctAnswer:'Pictures', why:'Text-to-image GenAI generates visual content from natural language descriptions.', category:'genai' },
  // ── WORK ────────────────────────────────────────────────────────
  { id:'q132', text:'AI can help detect fraud in…?', options:['Traffic lights','Cooking recipes','Bank transactions','Weather forecasts'], correctIndex:2, correctAnswer:'Bank transactions', why:'Financial fraud detection was one of the first enterprise AI applications.', category:'work' },
  // ── BASIC ────────────────────────────────────────────────────────
  { id:'q133', text:'Self-checkout item detection may use…?', options:['Kites','Candles','AI','Bells'], correctIndex:2, correctAnswer:'AI', why:'Computer vision at checkout identifies products by appearance instead of just barcodes.', category:'basic' },
  { id:'q134', text:'AI easily beats humans at…?', options:['Fast calculations','Napping','Feeling love','Tasting cake'], correctIndex:0, correctAnswer:'Fast calculations', why:'Computers (and AI) far outperform humans at arithmetic and large-scale computations.', category:'basic' },
  // ── ETHICS ────────────────────────────────────────────────────────
  { id:'q135', text:'AI recommendations can sometimes feel…?', options:['Too cold','Too repetitive','Too tasty','Too heavy'], correctIndex:1, correctAnswer:'Too repetitive', why:'Over-optimised recommendations create filter bubbles and repetitive content loops.', category:'ethics' },
  // ── BASIC ────────────────────────────────────────────────────────
  { id:'q136', text:'A smart speaker answering questions uses…?', options:['A fan','A drum','A mirror','AI'], correctIndex:3, correctAnswer:'AI', why:'Smart speakers use ASR + NLP + LLM technology to understand and answer queries.', category:'basic' },
  { id:'q137', text:'AI translation helps…?', options:['Nobody','Only teachers','Only robots','Travelers'], correctIndex:3, correctAnswer:'Travelers', why:'Real-time translation apps like Google Translate break language barriers for anyone.', category:'basic' },
  { id:'q138', text:'AI can help students by…?', options:['Tying shoes','Eating lunch','Explaining topics','Sleeping for them'], correctIndex:2, correctAnswer:'Explaining topics', why:'AI tutors, writing assistants, and explainers make learning more accessible.', category:'basic' },
  { id:'q139', text:'A virtual assistant lives…?', options:['In your shoe','In your fridge','In the garden','In software'], correctIndex:3, correctAnswer:'In software', why:'Virtual assistants are software programs running on servers or local devices.', category:'basic' },
  { id:'q140', text:'AI image tools can remove a photo\'s…?', options:['Wifi','Background','Screen','Battery'], correctIndex:1, correctAnswer:'Background', why:'Background removal uses semantic segmentation — a computer vision technique.', category:'basic' },
  // ── GENAI ────────────────────────────────────────────────────────
  { id:'q141', text:'AI can write a first draft of a…?', options:['Car engine','Sandwich','Report or email','Physical bridge'], correctIndex:2, correctAnswer:'Report or email', why:'GenAI is widely used for drafting, summarising, and editing written content.', category:'genai' },
  // ── BASIC ────────────────────────────────────────────────────────
  { id:'q142', text:'Which is a limit of AI today?', options:['Never makes errors','Tastes food','Can be confidently wrong','Feels real pain'], correctIndex:2, correctAnswer:'Can be confidently wrong', why:'Hallucination is AI\'s most cited current limitation — false confidence in wrong answers.', category:'basic' },
  { id:'q143', text:'AI answers are generated…?', options:['By hand','Automatically by software','By phone call','By mail'], correctIndex:1, correctAnswer:'Automatically by software', why:'AI responses are computed by software running mathematical operations on model weights.', category:'basic' },
  { id:'q144', text:'AI in cameras can blur the…?', options:['Screen','Only the sky','Background','Lens forever'], correctIndex:2, correctAnswer:'Background', why:'Portrait mode uses depth estimation + segmentation to blur backgrounds naturally.', category:'basic' },
  // ── GENAI ────────────────────────────────────────────────────────
  { id:'q145', text:'AI can turn a selfie into a…?', options:['Cartoon avatar','Song','Real twin','Snack'], correctIndex:0, correctAnswer:'Cartoon avatar', why:'Style-transfer and face-aware GenAI can stylise photos into cartoons or artwork.', category:'genai' },
  // ── BASIC ────────────────────────────────────────────────────────
  { id:'q146', text:'Which best describes AI?', options:['A planet','A dance','A type of food','Machines doing smart tasks'], correctIndex:3, correctAnswer:'Machines doing smart tasks', why:'AI systems perform tasks that typically require human intelligence, like understanding language.', category:'basic' },
  { id:'q147', text:'A training set is used to…?', options:['Cool the AI','Paint the AI','Teach the AI','Charge the AI'], correctIndex:2, correctAnswer:'Teach the AI', why:'The training set is the labelled data used to adjust model weights during learning.', category:'basic' },
  { id:'q148', text:'AI that plays chess is…?', options:['A clock','A pawn','A chessboard','A game-playing AI program'], correctIndex:3, correctAnswer:'A game-playing AI program', why:'Chess engines like Stockfish and AlphaZero use search algorithms and neural networks.', category:'basic' },
  { id:'q149', text:'AI can recognise emotions in…?', options:['Facial expressions','Rock colours','Furniture','Shoe sizes'], correctIndex:0, correctAnswer:'Facial expressions', why:'Affective computing uses computer vision to detect emotional states from facial cues.', category:'basic' },
  { id:'q150', text:'Which is true about AI?', options:['It sleeps nightly','It ages like humans','It learns from data','It eats food'], correctIndex:2, correctAnswer:'It learns from data', why:'AI models learn from data during training — they don\'t have biological needs.', category:'basic' },
  // ── GENAI ────────────────────────────────────────────────────────
  { id:'q151', text:'What does the \'T\' stand for in GPT?', options:['Tokenizer','Tensor','Transformer','Translator'], correctIndex:2, correctAnswer:'Transformer', why:'GPT stands for Generative Pre-trained Transformer, introduced in 2018.', category:'genai' },
  { id:'q152', text:'Which attention mechanism allows Transformers to process long sequences efficiently?', options:['Fast-Focus','Self-Attention','Dual-Scan','Echo-Attention'], correctIndex:1, correctAnswer:'Self-Attention', why:'Self-attention weighs the importance of all words in a sentence relative to each other.', category:'genai' },
  { id:'q153', text:'What temperature setting produces the most deterministic (least random) LLM output?', options:['0.0','2.0','1.0','0.7'], correctIndex:0, correctAnswer:'0.0', why:'Temperature 0 makes the model greedily select the highest-probability token every time.', category:'genai' },
  { id:'q154', text:'What is the primary function of a Vector Database in AI applications?', options:['Fast similarity search on embeddings','Rendering 3D graphics','Compiling JavaScript code','Storing relational SQL tables'], correctIndex:0, correctAnswer:'Fast similarity search on embeddings', why:'Vector databases (e.g. Pinecone, Chroma, pgvector) index high-dimensional embeddings for semantic search.', category:'genai' },
  { id:'q155', text:'In diffusion models like Midjourney or Stable Diffusion, images are created by…?', options:['Stitching web photos together','Iteratively removing noise from random pixels','Interpolating 3D meshes','Drawing SVG vector paths'], correctIndex:1, correctAnswer:'Iteratively removing noise from random pixels', why:'Diffusion models start with pure Gaussian noise and reverse the noise step-by-step into clear images.', category:'genai' },
  { id:'q156', text:'What is RLHF in modern LLM alignment?', options:['Real-time Language High-Frequency','Reinforcement Learning from Human Feedback','Recursive Logic Handling Framework','Randomized Linear Hyper-Filtering'], correctIndex:1, correctAnswer:'Reinforcement Learning from Human Feedback', why:'RLHF trains reward models on human preferences to make LLMs helpful, harmless, and honest.', category:'genai' },
  { id:'q157', text:'Which parameter controls the nucleus sampling cutoff probability in LLMs?', options:['Top-K','Temperature','Top-P','Alpha-Scale'], correctIndex:2, correctAnswer:'Top-P', why:'Top-P (nucleus sampling) pools only the smallest set of tokens whose cumulative probability exceeds P.', category:'genai' },
  { id:'q158', text:'Which company created Claude and the Constitutional AI framework?', options:['Google DeepMind','Meta','Anthropic','OpenAI'], correctIndex:2, correctAnswer:'Anthropic', why:'Anthropic was founded by former OpenAI researchers and created Claude and Constitutional AI.', category:'genai' },
  { id:'q159', text:'What does \'LoRA\' stand for in fine-tuning large models?', options:['Linear Optimal Regression Array','Long Range Attention','Localized Redundancy Algorithm','Low-Rank Adaptation'], correctIndex:3, correctAnswer:'Low-Rank Adaptation', why:'LoRA freezes pre-trained model weights and injects trainable rank-decomposition matrices.', category:'genai' },
  { id:'q160', text:'Which model architecture powers the open-source Llama family?', options:['Convolutional ResNet','Decoder-only Transformer','Encoder-only Transformer','Recurrent Neural Network'], correctIndex:1, correctAnswer:'Decoder-only Transformer', why:'Llama is an autoregressive decoder-only Transformer model developed by Meta AI.', category:'genai' },
  { id:'q161', text:'What technique asks an LLM to \'think step-by-step\' before producing an answer?', options:['Chain-of-Thought (CoT)','Tree of Vectors','Gradient Descent','Direct Execution'], correctIndex:0, correctAnswer:'Chain-of-Thought (CoT)', why:'Chain-of-Thought prompting encourages the model to generate reasoning steps before the final answer.', category:'genai' },
  { id:'q162', text:'What is \'System Prompt\' in an LLM conversation?', options:['The operating system boot script','High-level instructions defining the AI\'s role and behavior','The database backup query','The user\'s Wi-Fi password'], correctIndex:1, correctAnswer:'High-level instructions defining the AI\'s role and behavior', why:'System prompts configure the AI persona, rules, boundaries, and tone across the entire session.', category:'genai' },
  { id:'q163', text:'Which open-source framework is most famous for building LLM agents and chaining components?', options:['Bootstrap','TensorFlow.js','jQuery','LangChain'], correctIndex:3, correctAnswer:'LangChain', why:'LangChain is widely used for building LLM workflows, agent tool calling, and RAG pipelines.', category:'genai' },
  { id:'q164', text:'What is \'Quantization\' in machine learning model deployment?', options:['Translating code from Python to C++','Compressing images with JPEG','Increasing number of layers','Reducing numerical precision of weights (e.g. 16-bit to 4-bit)'], correctIndex:3, correctAnswer:'Reducing numerical precision of weights (e.g. 16-bit to 4-bit)', why:'Quantization shrinks model memory footprint and boosts inference speed with minimal accuracy loss.', category:'genai' },
  { id:'q165', text:'What is an AI \'Embedding\'?', options:['A high-dimensional vector representing semantic meaning','A compressed audio file','A hardware chip inside a phone','An encrypted password hash'], correctIndex:0, correctAnswer:'A high-dimensional vector representing semantic meaning', why:'Embeddings place concepts close together in vector space if their meanings are semantically similar.', category:'genai' },
  // ── ML ────────────────────────────────────────────────────────
  { id:'q166', text:'Which activation function is most widely used in modern hidden layers of neural networks?', options:['Binary Threshold','ReLU (Rectified Linear Unit)','Sigmoid','Step Function'], correctIndex:1, correctAnswer:'ReLU (Rectified Linear Unit)', why:'ReLU computes f(x) = max(0, x), preventing vanishing gradient problems and running fast.', category:'ml' },
  { id:'q167', text:'What problem occurs when a model memorises training data but fails on unseen test data?', options:['Gradient Exploding','Overfitting','Quantization','Underfitting'], correctIndex:1, correctAnswer:'Overfitting', why:'Overfitting happens when a model learns noise and specific details rather than general patterns.', category:'ml' },
  { id:'q168', text:'Which algorithm is the cornerstone of updating neural network weights via gradients?', options:['Dijkstra\'s Algorithm','Backpropagation','Quicksort','Binary Search'], correctIndex:1, correctAnswer:'Backpropagation', why:'Backpropagation uses the chain rule of calculus to compute loss gradients layer by layer.', category:'ml' },
  { id:'q169', text:'In Supervised Learning, what must the training data always include?', options:['Only unlabelled images','Input features and ground truth labels','Audio files only','Source code comments'], correctIndex:1, correctAnswer:'Input features and ground truth labels', why:'Supervised learning trains models on pairs of inputs and verified correct target labels.', category:'ml' },
  { id:'q170', text:'Which metric measures the balance between Precision and Recall?', options:['R-Squared','Mean Squared Error','F1-Score','Cosine Similarity'], correctIndex:2, correctAnswer:'F1-Score', why:'F1-score is the harmonic mean of precision and recall: 2 * (P * R) / (P + R).', category:'ml' },
  { id:'q171', text:'Which type of learning involves an agent receiving rewards and penalties from an environment?', options:['Unsupervised Learning','Rule-based Expert Systems','Static Clustering','Reinforcement Learning'], correctIndex:3, correctAnswer:'Reinforcement Learning', why:'Reinforcement Learning (RL) trains agents to maximize cumulative rewards through trial and error.', category:'ml' },
  { id:'q172', text:'What does \'CNN\' stand for in computer vision?', options:['Convolutional Neural Network','Cascaded Numerical Nexus','Continuous Node Network','Central Neuronal Node'], correctIndex:0, correctAnswer:'Convolutional Neural Network', why:'CNNs apply convolution filters to spatial data, making them ideal for image recognition.', category:'ml' },
  { id:'q173', text:'Which technique randomly drops neurons during training to reduce overfitting?', options:['Batch Normalization','Pruning','Downsampling','Dropout'], correctIndex:3, correctAnswer:'Dropout', why:'Dropout randomly sets a fraction of neuron outputs to zero at each update cycle.', category:'ml' },
  { id:'q174', text:'What type of ML is K-Means Clustering?', options:['Reinforcement Learning','Supervised Learning','Unsupervised Learning','Evolutionary Algorithm'], correctIndex:2, correctAnswer:'Unsupervised Learning', why:'K-Means groups data into K clusters based on Euclidean distance without any predefined labels.', category:'ml' },
  { id:'q175', text:'Which Python library is built and maintained primarily by Meta for deep learning?', options:['TensorFlow','Scikit-Learn','Pandas','PyTorch'], correctIndex:3, correctAnswer:'PyTorch', why:'PyTorch is a leading open-source machine learning framework created by Meta AI.', category:'ml' },
  // ── ETHICS ────────────────────────────────────────────────────────
  { id:'q176', text:'What is \'Data Poisoning\' in adversarial machine learning?', options:['Spilling water on GPU servers','Injecting malicious training data to manipulate model behavior','Deleting the server database','Encrypting files with ransomware'], correctIndex:1, correctAnswer:'Injecting malicious training data to manipulate model behavior', why:'Data poisoning introduces corrupt samples during training to create backdoors or degrade accuracy.', category:'ethics' },
  { id:'q177', text:'What does AI \'Model Drift\' mean in production systems?', options:['Degradation in accuracy as real-world data patterns change over time','A slow internet connection','Physical movement of server racks','The model renaming its own files'], correctIndex:0, correctAnswer:'Degradation in accuracy as real-world data patterns change over time', why:'Concept drift and data drift happen when real-world distributions shift away from baseline training data.', category:'ethics' },
  { id:'q178', text:'What is \'Prompt Injection\' in LLM application security?', options:['Manipulating an AI via user input to bypass system instructions','Overheating the CPU with heavy tasks','Injecting SQL commands into a database','Hacking the Wi-Fi router'], correctIndex:0, correctAnswer:'Manipulating an AI via user input to bypass system instructions', why:'Prompt injection tricks the LLM into ignoring its system prompt and executing unauthorized actions.', category:'ethics' },
  { id:'q179', text:'What does EU AI Act classify as \'Unacceptable Risk\' AI?', options:['AI photo filters','Social scoring by governments and cognitive manipulation','Spam filters in email','Video game enemy AI'], correctIndex:1, correctAnswer:'Social scoring by governments and cognitive manipulation', why:'The EU AI Act bans social scoring systems and subliminal behavioral manipulation technologies.', category:'ethics' },
  { id:'q180', text:'Why is synthetic watermark detection (e.g. SynthID) important?', options:['To make images load faster','To verify if digital content was generated by an AI model','To encrypt user passwords','To reduce file size'], correctIndex:1, correctAnswer:'To verify if digital content was generated by an AI model', why:'Watermarking embeds imperceptible signals in AI-generated text, audio, and images to detect synthetic media.', category:'ethics' },
  // ── APPLIED ────────────────────────────────────────────────────────
  { id:'q181', text:'What capability distinguishes an \'AI Agent\' from a traditional chatbot?', options:['Remembering past 2 messages','Speaking in different languages','Autonomous tool execution and multi-step goal planning','Displaying emojis'], correctIndex:2, correctAnswer:'Autonomous tool execution and multi-step goal planning', why:'AI agents can formulate plans, execute API/browser/file tools, evaluate outcomes, and iterate toward a goal.', category:'applied' },
  { id:'q182', text:'What is \'Function Calling\' (or Tool Use) in modern LLM APIs?', options:['LLM outputting structured JSON to trigger external API actions','Playing audio waveforms','Calling phone numbers using Voip','Compiling C++ code in background'], correctIndex:0, correctAnswer:'LLM outputting structured JSON to trigger external API actions', why:'Function calling allows LLMs to interact with databases, calculators, web search, and internal APIs.', category:'applied' },
  { id:'q183', text:'Which company manufactures the dominant H100 and Blackwell AI GPUs?', options:['AMD','Qualcomm','Intel','NVIDIA'], correctIndex:3, correctAnswer:'NVIDIA', why:'NVIDIA designs Hopper (H100) and Blackwell GPUs that accelerate the majority of AI training workloads.', category:'applied' },
  { id:'q184', text:'What is \'CUDA\' in high-performance AI computing?', options:['NVIDIA\'s parallel computing platform and API for GPUs','An image editing software','A database management tool','A Python package manager'], correctIndex:0, correctAnswer:'NVIDIA\'s parallel computing platform and API for GPUs', why:'CUDA enables developers to use GPU parallel processing for matrix multiplications in deep learning.', category:'applied' },
  { id:'q185', text:'What does \'TPU\' stand for in Google Cloud AI infrastructure?', options:['Transmission Power Unit','Tensor Processing Unit','Target Program Unifier','Total Performance Utility'], correctIndex:1, correctAnswer:'Tensor Processing Unit', why:'Google custom-designed TPUs specifically to accelerate machine learning workloads and Gemini training.', category:'applied' },
  { id:'q186', text:'What is \'Zero-ETL\' in modern cloud data analytics?', options:['Storing data without encryption','Deleting all historical logs','Direct querying of transactional data without custom extract/load pipelines','Running databases on CPU only'], correctIndex:2, correctAnswer:'Direct querying of transactional data without custom extract/load pipelines', why:'Zero-ETL eliminates manual data pipelines by enabling direct integration between operational DBs and data warehouses.', category:'applied' },
  { id:'q187', text:'In web application architecture, what is WebSockets\' main advantage over HTTP polling?', options:['Automatic dark mode rendering','Better SEO indexing','Smaller file sizes for images','Full-duplex persistent real-time communication with low latency'], correctIndex:3, correctAnswer:'Full-duplex persistent real-time communication with low latency', why:'WebSockets maintain an open bidirectional channel, allowing instant sub-second server-to-client broadcasts.', category:'applied' },
  { id:'q188', text:'What is \'Edge AI\'?', options:['AI models hosted exclusively on Microsoft Edge','AI for drawing border edges in Photoshop','AI running on submarine cables','Running AI models locally on end-user devices rather than cloud servers'], correctIndex:3, correctAnswer:'Running AI models locally on end-user devices rather than cloud servers', why:'Edge AI performs inference directly on mobile phones, IoT chips, or cars for low latency and privacy.', category:'applied' },
  // ── GENAI ────────────────────────────────────────────────────────
  { id:'q189', text:'What is \'Multimodal AI\'?', options:['AI that can understand and process text, images, video, and audio together','AI that runs in multiple browser tabs','AI that requires two CPUs','AI with multiple user logins'], correctIndex:0, correctAnswer:'AI that can understand and process text, images, video, and audio together', why:'Multimodal models (like GPT-4o and Gemini 1.5) natively integrate visual, auditory, and textual signals.', category:'genai' },
  // ── APPLIED ────────────────────────────────────────────────────────
  { id:'q190', text:'Which open protocol is commonly used for AI agents to connect to local tools and resources?', options:['POP3','MCP (Model Context Protocol)','SMTP','FTP'], correctIndex:1, correctAnswer:'MCP (Model Context Protocol)', why:'Anthropic\'s open-standard Model Context Protocol connects LLM assistants to local data sources and tools.', category:'applied' },
  // ── BASIC ────────────────────────────────────────────────────────
  { id:'q191', text:'What does \'Turing Test\' originally measure?', options:['The memory bandwidth of a motherboard','A machine\'s ability to exhibit intelligent behavior indistinguishable from human','The battery life of a robot','The maximum clock speed of a processor'], correctIndex:1, correctAnswer:'A machine\'s ability to exhibit intelligent behavior indistinguishable from human', why:'Proposed by Alan Turing in 1950, the test checks if a human evaluator can distinguish machine from human in conversation.', category:'basic' },
  { id:'q192', text:'Which company developed AlphaGo, the AI that defeated world champion Lee Sedol in Go?', options:['IBM','Intel','Microsoft','Google DeepMind'], correctIndex:3, correctAnswer:'Google DeepMind', why:'DeepMind built AlphaGo using deep neural networks and Monte Carlo tree search, winning in 2016.', category:'basic' },
  { id:'q193', text:'What is \'Deep Blue\' famous for in AI history?', options:['The first self-driving car in 1980','IBM computer that defeated world chess champion Garry Kasparov in 1997','The first voice recognition system in 2000','The first text-to-image AI in 2010'], correctIndex:1, correctAnswer:'IBM computer that defeated world chess champion Garry Kasparov in 1997', why:'IBM\'s Deep Blue was the first computer system to defeat a reigning world chess champion in a standard match.', category:'basic' },
  { id:'q194', text:'What does \'NLP\' stand for in artificial intelligence?', options:['Numeric Logic Processor','Neural Layer Program','Natural Language Processing','Network Level Protocol'], correctIndex:2, correctAnswer:'Natural Language Processing', why:'NLP is the field of computer science and AI concerned with giving computers the ability to understand human language.', category:'basic' },
  { id:'q195', text:'What is \'Computer Vision\' primarily concerned with?', options:['Measuring human eyesight with lenses','Cleaning dirty camera sensors','Optimizing monitor refresh rates','Enabling computers to derive meaningful information from digital images and videos'], correctIndex:3, correctAnswer:'Enabling computers to derive meaningful information from digital images and videos', why:'Computer vision algorithms process visual data for tasks like facial recognition, autonomous driving, and medical imaging.', category:'basic' },
  { id:'q196', text:'What is an \'algorithm\' in computing?', options:['A type of computer virus','A step-by-step set of instructions to solve a problem','A piece of hardware','A programming language'], correctIndex:1, correctAnswer:'A step-by-step set of instructions to solve a problem', why:'An algorithm is a finite sequence of well-defined steps to accomplish a task.', category:'basic' },
  { id:'q197', text:'What does \'GPU\' stand for?', options:['General Processing Unit','Graphics Processing Unit','Global Power Unit','Grid Protocol Unit'], correctIndex:1, correctAnswer:'Graphics Processing Unit', why:'GPUs (Graphics Processing Units) handle parallel math and are heavily used to train AI models.', category:'basic' },
  { id:'q198', text:'Which of these is a programming language often used for AI?', options:['HTML','Python','CSS','SQL only'], correctIndex:1, correctAnswer:'Python', why:'Python is the most popular language for AI and machine learning work.', category:'basic' },
  { id:'q199', text:'What is \'training data\'?', options:['Data used to teach an AI model','A user manual','A backup file','A password list'], correctIndex:0, correctAnswer:'Data used to teach an AI model', why:'Training data is the examples a model learns patterns from.', category:'basic' },
  { id:'q200', text:'A \'neural network\' is loosely inspired by…?', options:['The human brain','A spider web','A car engine','A river system'], correctIndex:0, correctAnswer:'The human brain', why:'Artificial neural networks are inspired by the connected neurons of the brain.', category:'basic' },
  { id:'q201', text:'What does \'AGI\' stand for?', options:['Artificial General Intelligence','Automatic Graphics Interface','Applied Global Internet','Advanced Gaming Input'], correctIndex:0, correctAnswer:'Artificial General Intelligence', why:'AGI = Artificial General Intelligence, a hypothetical AI matching humans across most tasks.', category:'basic' },
  { id:'q202', text:'Which task is an example of \'classification\'?', options:['Sorting emails into spam or not spam','Adding two numbers','Deleting a file','Printing a page'], correctIndex:0, correctAnswer:'Sorting emails into spam or not spam', why:'Classification assigns inputs to discrete categories, like spam vs. not-spam.', category:'basic' },
  { id:'q203', text:'A \'dataset\' is best described as…?', options:['A single number','A collection of data used together','A type of monitor','A network cable'], correctIndex:1, correctAnswer:'A collection of data used together', why:'A dataset is an organized collection of data used for analysis or training.', category:'basic' },
  { id:'q204', text:'Which is an example of AI in everyday life?', options:['A paper notebook','Autocorrect on your phone','A wooden chair','A glass of water'], correctIndex:1, correctAnswer:'Autocorrect on your phone', why:'Autocorrect and predictive text use AI language models.', category:'basic' },
  { id:'q205', text:'What does \'bug\' mean in software?', options:['A helpful feature','An error or flaw in the code','A type of memory','A user account'], correctIndex:1, correctAnswer:'An error or flaw in the code', why:'A bug is a mistake in code that causes incorrect behavior.', category:'basic' },
  { id:'q206', text:'What is \'computer vision\' used for?', options:['Understanding images and video','Playing audio','Sending emails','Charging batteries'], correctIndex:0, correctAnswer:'Understanding images and video', why:'Computer vision lets machines interpret visual information.', category:'basic' },
  { id:'q207', text:'Which of these is a real AI voice assistant?', options:['Google Assistant','Microsoft Word','Adobe Reader','WinZip'], correctIndex:0, correctAnswer:'Google Assistant', why:'Google Assistant is an AI-powered voice assistant.', category:'basic' },
  { id:'q208', text:'What does \'API\' stand for?', options:['Applied Programming Idea','Application Programming Interface','Automatic Personal Internet','Advanced Program Index'], correctIndex:1, correctAnswer:'Application Programming Interface', why:'An API (Application Programming Interface) lets programs talk to each other.', category:'basic' },
  { id:'q209', text:'A model that predicts a number (like house price) is doing…?', options:['Regression','Deletion','Compression','Encryption'], correctIndex:0, correctAnswer:'Regression', why:'Regression predicts continuous numeric values.', category:'basic' },
  { id:'q210', text:'What is \'open source\' software?', options:['Software whose code is publicly available','Software that costs the most','Software with no code','Broken software'], correctIndex:0, correctAnswer:'Software whose code is publicly available', why:'Open-source software has source code anyone can view, use, and modify.', category:'basic' },
  { id:'q211', text:'Which company created the GPT series of models?', options:['OpenAI','Netflix','Spotify','Uber'], correctIndex:0, correctAnswer:'OpenAI', why:'OpenAI created the GPT (Generative Pre-trained Transformer) family.', category:'basic' },
  { id:'q212', text:'What is a \'server\' in computing?', options:['A computer that provides services to other computers','A type of keyboard','A phone app','A screen'], correctIndex:0, correctAnswer:'A computer that provides services to other computers', why:'A server responds to requests from client machines over a network.', category:'basic' },
  { id:'q213', text:'\'Cloud computing\' mainly means…?', options:['Using remote computers over the internet','Weather prediction','A type of monitor','Offline gaming'], correctIndex:0, correctAnswer:'Using remote computers over the internet', why:'Cloud computing delivers computing power and storage over the internet.', category:'basic' },
  { id:'q214', text:'Which is a common AI use in healthcare?', options:['Analyzing medical scans','Mopping floors','Cooking meals','Cutting grass'], correctIndex:0, correctAnswer:'Analyzing medical scans', why:'AI helps analyze X-rays, MRIs, and other medical images.', category:'basic' },
  { id:'q215', text:'What is \'natural language\' in AI?', options:['Human language like English or Hindi','Binary code','Machine code','A cable type'], correctIndex:0, correctAnswer:'Human language like English or Hindi', why:'Natural language is the everyday human language AI systems try to understand.', category:'basic' },
  { id:'q216', text:'What does \'OCR\' do?', options:['Reads text from images','Plays music','Cools the CPU','Blocks ads'], correctIndex:0, correctAnswer:'Reads text from images', why:'OCR (Optical Character Recognition) converts pictures of text into editable text.', category:'basic' },
  { id:'q217', text:'A \'label\' in supervised learning is…?', options:['The correct answer for a training example','A sticker on hardware','A file name','A network address'], correctIndex:0, correctAnswer:'The correct answer for a training example', why:'In supervised learning, labels are the known correct outputs used for training.', category:'basic' },
  { id:'q218', text:'What is \'binary\'?', options:['A number system using only 0 and 1','A type of AI model','A web browser','A social network'], correctIndex:0, correctAnswer:'A number system using only 0 and 1', why:'Computers store data in binary, using only 0s and 1s.', category:'basic' },
  { id:'q219', text:'Which is an example of a \'sensor\' used by AI systems?', options:['A camera','A pencil','A book','A cup'], correctIndex:0, correctAnswer:'A camera', why:'Cameras, microphones, and other sensors feed real-world data to AI.', category:'basic' },
  { id:'q220', text:'What does \'IoT\' stand for?', options:['Internet of Things','Index of Text','Input on Time','Internal Optical Transfer'], correctIndex:0, correctAnswer:'Internet of Things', why:'IoT = Internet of Things, everyday devices connected to the internet.', category:'basic' },
  { id:'q221', text:'A \'chatbot\' primarily helps with…?', options:['Automated conversations','Cutting vegetables','Painting walls','Driving trains'], correctIndex:0, correctAnswer:'Automated conversations', why:'Chatbots automate text or voice conversations with users.', category:'basic' },
  { id:'q222', text:'What is \'speech recognition\'?', options:['Turning spoken words into text','Turning text into images','Compressing files','Encrypting emails'], correctIndex:0, correctAnswer:'Turning spoken words into text', why:'Speech recognition converts audio speech into written text.', category:'basic' },
  { id:'q223', text:'Which best describes \'automation\'?', options:['Making tasks run without manual effort','Slowing down computers','Deleting all data','Turning off the internet'], correctIndex:0, correctAnswer:'Making tasks run without manual effort', why:'Automation uses technology to perform tasks with minimal human intervention.', category:'basic' },
  { id:'q224', text:'What is a \'pixel\'?', options:['The smallest dot in a digital image','A software bug','A type of AI','A network port'], correctIndex:0, correctAnswer:'The smallest dot in a digital image', why:'Images are made of tiny colored dots called pixels.', category:'basic' },
  { id:'q225', text:'Which of these is structured data?', options:['A spreadsheet table','A random voice note','A blurry photo','A handwritten scribble'], correctIndex:0, correctAnswer:'A spreadsheet table', why:'Structured data is organized in rows and columns, like a table.', category:'basic' },
  { id:'q226', text:'In machine learning, \'features\' are…?', options:['The input variables a model uses','The model\'s price','The screen size','The company logo'], correctIndex:0, correctAnswer:'The input variables a model uses', why:'Features are the measurable input properties a model learns from.', category:'ml' },
  { id:'q227', text:'What is \'overfitting\'?', options:['When a model memorizes training data but fails on new data','When a model is too small','When data is deleted','When the GPU overheats'], correctIndex:0, correctAnswer:'When a model memorizes training data but fails on new data', why:'Overfitting means the model fits training data too closely and generalizes poorly.', category:'ml' },
  { id:'q228', text:'What is \'underfitting\'?', options:['When a model is too simple to capture patterns','When a model is perfect','When training is too long','When data is encrypted'], correctIndex:0, correctAnswer:'When a model is too simple to capture patterns', why:'Underfitting means the model is too simple to learn the underlying pattern.', category:'ml' },
  { id:'q229', text:'\'Supervised learning\' uses…?', options:['Labeled data','No data','Only images','Only audio'], correctIndex:0, correctAnswer:'Labeled data', why:'Supervised learning trains on input-output pairs with known labels.', category:'ml' },
  { id:'q230', text:'\'Unsupervised learning\' works with…?', options:['Unlabeled data to find patterns','Only labeled data','Only text','Only numbers under 10'], correctIndex:0, correctAnswer:'Unlabeled data to find patterns', why:'Unsupervised learning finds structure in data without labels, e.g. clustering.', category:'ml' },
  { id:'q231', text:'What is \'reinforcement learning\'?', options:['Learning by trial and error with rewards','Copying a textbook','Deleting bad data','Sorting files'], correctIndex:0, correctAnswer:'Learning by trial and error with rewards', why:'Reinforcement learning trains agents via rewards and penalties from their actions.', category:'ml' },
  { id:'q232', text:'A \'training/test split\' is used to…?', options:['Check how well a model generalizes','Speed up the internet','Save battery','Compress images'], correctIndex:0, correctAnswer:'Check how well a model generalizes', why:'Splitting data lets you evaluate a model on data it did not train on.', category:'ml' },
  { id:'q233', text:'What does a model\'s \'accuracy\' measure?', options:['The fraction of correct predictions','The file size','The download speed','The screen brightness'], correctIndex:0, correctAnswer:'The fraction of correct predictions', why:'Accuracy is the proportion of predictions the model got right.', category:'ml' },
  { id:'q234', text:'\'Clustering\' groups data by…?', options:['Similarity','Alphabetical order only','File size only','Random chance'], correctIndex:0, correctAnswer:'Similarity', why:'Clustering groups similar data points together without predefined labels.', category:'ml' },
  { id:'q235', text:'What is a \'hyperparameter\'?', options:['A setting chosen before training (e.g. learning rate)','A hardware chip','A type of dataset','A password'], correctIndex:0, correctAnswer:'A setting chosen before training (e.g. learning rate)', why:'Hyperparameters are configuration values set before training begins.', category:'ml' },
  { id:'q236', text:'The \'learning rate\' controls…?', options:['How big each training update step is','The screen resolution','The number of users','The internet speed'], correctIndex:0, correctAnswer:'How big each training update step is', why:'Learning rate sets how much the model adjusts its weights each step.', category:'ml' },
  { id:'q237', text:'What is a \'loss function\'?', options:['A measure of how wrong the model\'s predictions are','A lost file','A network error','A type of GPU'], correctIndex:0, correctAnswer:'A measure of how wrong the model\'s predictions are', why:'The loss function quantifies prediction error, which training tries to minimize.', category:'ml' },
  { id:'q238', text:'\'Gradient descent\' is used to…?', options:['Minimize the loss by adjusting weights','Draw graphs','Delete data','Encrypt files'], correctIndex:0, correctAnswer:'Minimize the loss by adjusting weights', why:'Gradient descent iteratively updates weights to reduce the loss.', category:'ml' },
  { id:'q239', text:'What is a \'decision tree\'?', options:['A model that splits data using yes/no questions','A real tree','A file folder','A network cable'], correctIndex:0, correctAnswer:'A model that splits data using yes/no questions', why:'A decision tree makes predictions by asking a sequence of branching questions.', category:'ml' },
  { id:'q240', text:'\'Deep learning\' uses neural networks with…?', options:['Many layers','Only one neuron','No math','No data'], correctIndex:0, correctAnswer:'Many layers', why:'Deep learning uses networks with many hidden layers to learn complex patterns.', category:'ml' },
  { id:'q241', text:'What is \'data preprocessing\'?', options:['Cleaning and preparing data before training','Deleting the model','Buying hardware','Writing emails'], correctIndex:0, correctAnswer:'Cleaning and preparing data before training', why:'Preprocessing cleans, formats, and transforms raw data for modeling.', category:'ml' },
  { id:'q242', text:'A \'feature\' that leaks the answer causes…?', options:['Data leakage and misleading results','Faster internet','Better battery','Nothing at all'], correctIndex:0, correctAnswer:'Data leakage and misleading results', why:'Data leakage happens when training data includes information it shouldn\'t, inflating results.', category:'ml' },
  { id:'q243', text:'\'Cross-validation\' helps you…?', options:['Estimate model performance more reliably','Charge the laptop','Send messages','Print documents'], correctIndex:0, correctAnswer:'Estimate model performance more reliably', why:'Cross-validation tests the model on multiple data splits for a robust estimate.', category:'ml' },
  { id:'q244', text:'What is a \'confusion matrix\'?', options:['A table showing correct vs incorrect predictions','A puzzle game','A GPU model','A password vault'], correctIndex:0, correctAnswer:'A table showing correct vs incorrect predictions', why:'A confusion matrix summarizes true/false positives and negatives.', category:'ml' },
  { id:'q245', text:'\'Bias\' in ML data can lead to…?', options:['Unfair or skewed predictions','Faster training only','More storage','Louder speakers'], correctIndex:0, correctAnswer:'Unfair or skewed predictions', why:'Biased data can make models produce unfair or inaccurate outcomes.', category:'ml' },
  { id:'q246', text:'What is \'transfer learning\'?', options:['Reusing a pre-trained model for a new task','Moving files between drives','Sending data by email','Copying a hard disk'], correctIndex:0, correctAnswer:'Reusing a pre-trained model for a new task', why:'Transfer learning adapts knowledge from one task to speed up learning another.', category:'ml' },
  { id:'q247', text:'An \'epoch\' in training is…?', options:['One full pass through the training data','A single pixel','A GPU brand','A type of loss'], correctIndex:0, correctAnswer:'One full pass through the training data', why:'An epoch is one complete pass of the model over the entire training set.', category:'ml' },
  { id:'q248', text:'\'Feature scaling\' (normalization) helps because…?', options:['It puts features on a comparable range','It deletes features','It adds noise','It hides the labels'], correctIndex:0, correctAnswer:'It puts features on a comparable range', why:'Scaling brings features to similar ranges so none dominates unfairly.', category:'ml' },
  { id:'q249', text:'What is \'ensemble learning\'?', options:['Combining multiple models for better results','Using one tiny model','Turning off training','Deleting weak data'], correctIndex:0, correctAnswer:'Combining multiple models for better results', why:'Ensembles combine several models (e.g. random forests) to improve accuracy.', category:'ml' },
  { id:'q250', text:'What does \'LLM\' stand for?', options:['Large Language Model','Long Loading Machine','Local Login Manager','Layered Logic Model'], correctIndex:0, correctAnswer:'Large Language Model', why:'LLM = Large Language Model, trained on huge amounts of text.', category:'genai' },
  { id:'q251', text:'The \'T\' in GPT stands for…?', options:['Transformer','Text','Terminal','Table'], correctIndex:0, correctAnswer:'Transformer', why:'GPT = Generative Pre-trained Transformer; the transformer is the neural architecture.', category:'genai' },
  { id:'q252', text:'Which paper introduced the Transformer architecture?', options:['\'Attention Is All You Need\'','\'Hello World\'','\'Deep Blue Wins\'','\'The Turing Test\''], correctIndex:0, correctAnswer:'\'Attention Is All You Need\'', why:'The 2017 paper \'Attention Is All You Need\' introduced transformers.', category:'genai' },
  { id:'q253', text:'\'Temperature\' in an LLM controls…?', options:['How random/creative the output is','The CPU heat','The battery level','The font size'], correctIndex:0, correctAnswer:'How random/creative the output is', why:'Higher temperature makes outputs more random; lower makes them more focused.', category:'genai' },
  { id:'q254', text:'An \'embedding\' represents text as…?', options:['A vector of numbers','A picture','A sound clip','A password'], correctIndex:0, correctAnswer:'A vector of numbers', why:'Embeddings turn words or text into numeric vectors capturing meaning.', category:'genai' },
  { id:'q255', text:'What is \'few-shot prompting\'?', options:['Giving the model a few examples in the prompt','Sending zero prompts','Shooting a video','Restarting the app'], correctIndex:0, correctAnswer:'Giving the model a few examples in the prompt', why:'Few-shot prompting includes a small number of examples to guide the model.', category:'genai' },
  { id:'q256', text:'\'Chain-of-thought\' prompting encourages the model to…?', options:['Show step-by-step reasoning','Skip the question','Delete its answer','Speak louder'], correctIndex:0, correctAnswer:'Show step-by-step reasoning', why:'Chain-of-thought asks the model to reason through steps before answering.', category:'genai' },
  { id:'q257', text:'Which is a text-to-image model?', options:['Stable Diffusion','Microsoft Excel','WinRAR','Notepad'], correctIndex:0, correctAnswer:'Stable Diffusion', why:'Stable Diffusion generates images from text prompts.', category:'genai' },
  { id:'q258', text:'What is \'Midjourney\'?', options:['An AI image generation tool','A travel website','A music player','A spreadsheet app'], correctIndex:0, correctAnswer:'An AI image generation tool', why:'Midjourney is a popular AI tool that creates images from text descriptions.', category:'genai' },
  { id:'q259', text:'\'Multimodal\' AI can handle…?', options:['Multiple types of input like text and images','Only one language','Only numbers','Only audio'], correctIndex:0, correctAnswer:'Multiple types of input like text and images', why:'Multimodal models process more than one data type, e.g. text plus images.', category:'genai' },
  { id:'q260', text:'What does an LLM\'s \'parameters\' refer to?', options:['The learned weights inside the model','The user\'s settings','The keyboard keys','The screen pixels'], correctIndex:0, correctAnswer:'The learned weights inside the model', why:'Parameters are the billions of learned weights that define the model.', category:'genai' },
  { id:'q261', text:'\'System prompt\' in a chatbot is…?', options:['Instructions setting the assistant\'s behavior','A hardware button','A login screen','A file format'], correctIndex:0, correctAnswer:'Instructions setting the assistant\'s behavior', why:'The system prompt configures how the assistant should behave.', category:'genai' },
  { id:'q262', text:'Which model family is made by Anthropic?', options:['Claude','Gemini','Llama','Grok'], correctIndex:0, correctAnswer:'Claude', why:'Claude is the family of AI assistants built by Anthropic.', category:'genai' },
  { id:'q263', text:'Meta\'s open-weight LLM family is called…?', options:['Llama','Falcon','Bard','Copilot'], correctIndex:0, correctAnswer:'Llama', why:'Meta released the Llama family of open-weight language models.', category:'genai' },
  { id:'q264', text:'\'Text-to-speech\' (TTS) does what?', options:['Converts written text into spoken audio','Converts speech to text','Compresses text','Encrypts audio'], correctIndex:0, correctAnswer:'Converts written text into spoken audio', why:'TTS turns text into natural-sounding spoken voice.', category:'genai' },
  { id:'q265', text:'A \'diffusion model\' generates images by…?', options:['Gradually removing noise from random data','Copying existing photos exactly','Scanning documents','Recording video'], correctIndex:0, correctAnswer:'Gradually removing noise from random data', why:'Diffusion models start from noise and denoise step-by-step into an image.', category:'genai' },
  { id:'q266', text:'\'Grounding\' an LLM\'s answer means…?', options:['Basing it on reliable source data','Turning it off','Making it random','Deleting the prompt'], correctIndex:0, correctAnswer:'Basing it on reliable source data', why:'Grounding ties responses to real, verifiable source information.', category:'genai' },
  { id:'q267', text:'What is a \'vector database\' commonly used for?', options:['Storing embeddings for semantic search','Storing video games','Charging phones','Printing photos'], correctIndex:0, correctAnswer:'Storing embeddings for semantic search', why:'Vector databases store embeddings to enable similarity/semantic search.', category:'genai' },
  { id:'q268', text:'\'Prompt injection\' is a risk where…?', options:['Malicious text manipulates the model\'s behavior','The screen freezes','The battery drains','The mouse lags'], correctIndex:0, correctAnswer:'Malicious text manipulates the model\'s behavior', why:'Prompt injection sneaks instructions into inputs to hijack model behavior.', category:'genai' },
  { id:'q269', text:'Which describes \'in-context learning\'?', options:['The model adapts using examples in the prompt','The model is retrained fully','The model is deleted','The model prints code'], correctIndex:0, correctAnswer:'The model adapts using examples in the prompt', why:'In-context learning lets the model adapt from examples given at inference time.', category:'genai' },
  { id:'q270', text:'What is \'RLHF\'?', options:['Reinforcement Learning from Human Feedback','Random Logic Hardware Framework','Rapid Local Host File','Remote Login Home Folder'], correctIndex:0, correctAnswer:'Reinforcement Learning from Human Feedback', why:'RLHF fine-tunes models using human preference feedback.', category:'genai' },
  { id:'q271', text:'A \'guardrail\' in an AI system is…?', options:['A safety control limiting harmful outputs','A hardware bracket','A network cable','A screen protector'], correctIndex:0, correctAnswer:'A safety control limiting harmful outputs', why:'Guardrails are safety measures that keep AI outputs within acceptable bounds.', category:'genai' },
  { id:'q272', text:'What is \'summarization\' as an LLM task?', options:['Condensing long text into a shorter version','Making text longer','Translating only','Deleting text'], correctIndex:0, correctAnswer:'Condensing long text into a shorter version', why:'Summarization produces a concise version of longer content.', category:'genai' },
  { id:'q273', text:'\'Translation\' with an LLM converts…?', options:['Text from one language to another','Files into folders','Images into audio','Numbers into letters'], correctIndex:0, correctAnswer:'Text from one language to another', why:'LLMs can translate text between human languages.', category:'genai' },
  { id:'q274', text:'A \'copilot\' style AI assistant typically…?', options:['Helps a user complete tasks in an app','Flies real planes','Cleans the keyboard','Charges the battery'], correctIndex:0, correctAnswer:'Helps a user complete tasks in an app', why:'AI \'copilots\' assist users inside software like coding or office tools.', category:'genai' },
  { id:'q275', text:'What does \'fine-tuning\' change in a model?', options:['Its weights, adapted to new data','Its color theme','Its keyboard shortcuts','Its file name'], correctIndex:0, correctAnswer:'Its weights, adapted to new data', why:'Fine-tuning updates a model\'s weights on task-specific data.', category:'genai' },
  { id:'q276', text:'\'Hallucination\' is most risky when…?', options:['Users trust wrong answers as facts','The screen is bright','The prompt is short','The font is large'], correctIndex:0, correctAnswer:'Users trust wrong answers as facts', why:'Hallucinations are dangerous when confident but false outputs are believed.', category:'genai' },
  { id:'q277', text:'What is a \'token limit\' / context length?', options:['Max text a model can process at once','Max users allowed','Max battery hours','Max screen size'], correctIndex:0, correctAnswer:'Max text a model can process at once', why:'The context length caps how many tokens the model can handle per request.', category:'genai' },
  { id:'q278', text:'\'Retrieval-Augmented Generation\' (RAG) helps by…?', options:['Fetching relevant documents to inform answers','Deleting the model','Slowing responses','Hiding sources'], correctIndex:0, correctAnswer:'Fetching relevant documents to inform answers', why:'RAG retrieves external documents so answers use up-to-date, grounded info.', category:'genai' },
  { id:'q279', text:'Which is an AI coding assistant?', options:['GitHub Copilot','Microsoft Paint','VLC Player','7-Zip'], correctIndex:0, correctAnswer:'GitHub Copilot', why:'GitHub Copilot suggests and writes code using AI.', category:'genai' },
  { id:'q280', text:'A \'foundation model\' is…?', options:['A large model adaptable to many tasks','A concrete building base','A single-use script','A hardware chip'], correctIndex:0, correctAnswer:'A large model adaptable to many tasks', why:'Foundation models are broadly trained and adaptable to many downstream tasks.', category:'genai' },
  { id:'q281', text:'\'Text generation\' predicts…?', options:['The next tokens in a sequence','The weather','Stock prices only','The battery level'], correctIndex:0, correctAnswer:'The next tokens in a sequence', why:'LLMs generate text by predicting likely next tokens repeatedly.', category:'genai' },
  { id:'q282', text:'What is \'quantization\' of a model?', options:['Reducing precision of weights to save memory','Doubling the data','Encrypting the model','Adding more layers'], correctIndex:0, correctAnswer:'Reducing precision of weights to save memory', why:'Quantization stores weights at lower precision to shrink and speed up models.', category:'genai' },
  { id:'q283', text:'\'Watermarking\' AI output aims to…?', options:['Help identify AI-generated content','Improve battery life','Boost internet speed','Change the font'], correctIndex:0, correctAnswer:'Help identify AI-generated content', why:'Watermarking embeds signals to flag content as AI-generated.', category:'genai' },
  { id:'q284', text:'A \'context window\' of 128k tokens means…?', options:['It can consider up to ~128,000 tokens at once','It has 128k users','It costs 128k','It weighs 128kg'], correctIndex:0, correctAnswer:'It can consider up to ~128,000 tokens at once', why:'The context window is the max tokens the model reads in a single request.', category:'genai' },
  { id:'q285', text:'\'AI bias\' most often comes from…?', options:['Biased or unrepresentative training data','Too much electricity','Fast internet','Large screens'], correctIndex:0, correctAnswer:'Biased or unrepresentative training data', why:'Models can inherit and amplify biases present in their training data.', category:'ethics' },
  { id:'q286', text:'Why is \'transparency\' important in AI?', options:['So people understand how decisions are made','So the app looks nicer','To save battery','To speed up typing'], correctIndex:0, correctAnswer:'So people understand how decisions are made', why:'Transparency helps users trust and scrutinize AI decisions.', category:'ethics' },
  { id:'q287', text:'\'Data privacy\' means…?', options:['Protecting people\'s personal information','Sharing all data publicly','Deleting all data','Selling passwords'], correctIndex:0, correctAnswer:'Protecting people\'s personal information', why:'Data privacy protects individuals\' personal information from misuse.', category:'ethics' },
  { id:'q288', text:'A \'deepfake\' is…?', options:['Synthetic media that fakes a real person','A deep-sea photo','A type of GPU','A backup file'], correctIndex:0, correctAnswer:'Synthetic media that fakes a real person', why:'Deepfakes use AI to create convincing but fake images, audio, or video.', category:'ethics' },
  { id:'q289', text:'Which is a responsible use of AI?', options:['Disclosing when content is AI-generated','Impersonating people secretly','Spreading misinformation','Hiding all sources'], correctIndex:0, correctAnswer:'Disclosing when content is AI-generated', why:'Disclosing AI use is a key part of responsible, honest AI practice.', category:'ethics' },
  { id:'q290', text:'\'Accountability\' in AI means…?', options:['Someone is responsible for the system\'s outcomes','No one is responsible','The AI pays fines','Users are ignored'], correctIndex:0, correctAnswer:'Someone is responsible for the system\'s outcomes', why:'Accountability ensures humans/organizations answer for AI outcomes.', category:'ethics' },
  { id:'q291', text:'Why can facial recognition be controversial?', options:['Privacy and misidentification concerns','It uses too much paper','It needs no data','It is always accurate'], correctIndex:0, correctAnswer:'Privacy and misidentification concerns', why:'Facial recognition raises privacy risks and can misidentify people.', category:'ethics' },
  { id:'q292', text:'\'Informed consent\' for data means…?', options:['People agree to how their data is used','Data is taken secretly','Passwords are shared','Data is deleted randomly'], correctIndex:0, correctAnswer:'People agree to how their data is used', why:'Informed consent means users knowingly agree to data collection and use.', category:'ethics' },
  { id:'q293', text:'A key risk of AI in hiring is…?', options:['Discriminating against certain groups','Typing too fast','Using too much ink','Being too polite'], correctIndex:0, correctAnswer:'Discriminating against certain groups', why:'AI hiring tools can discriminate if trained on biased historical data.', category:'ethics' },
  { id:'q294', text:'\'Explainability\' helps stakeholders…?', options:['Understand why an AI made a decision','Change the screen color','Charge devices','Play music'], correctIndex:0, correctAnswer:'Understand why an AI made a decision', why:'Explainability clarifies the reasons behind AI decisions.', category:'ethics' },
  { id:'q295', text:'Spreading AI-generated fake news is an example of…?', options:['Misinformation/disinformation','Good journalism','Data backup','Cloud storage'], correctIndex:0, correctAnswer:'Misinformation/disinformation', why:'AI can be misused to mass-produce false or misleading information.', category:'ethics' },
  { id:'q296', text:'Why keep a \'human in the loop\'?', options:['To review and catch AI mistakes','To slow everything down','To avoid using computers','To increase errors'], correctIndex:0, correctAnswer:'To review and catch AI mistakes', why:'Human oversight helps catch errors and add judgment to AI decisions.', category:'ethics' },
  { id:'q297', text:'\'Algorithmic fairness\' aims to…?', options:['Treat different groups equitably','Make apps colorful','Reduce file size','Boost Wi-Fi'], correctIndex:0, correctAnswer:'Treat different groups equitably', why:'Fairness seeks to prevent unjust bias against particular groups.', category:'ethics' },
  { id:'q298', text:'Using copyrighted work to train AI raises questions about…?', options:['Intellectual property rights','Screen brightness','Battery life','Keyboard layout'], correctIndex:0, correctAnswer:'Intellectual property rights', why:'Training on copyrighted material raises unresolved IP and consent issues.', category:'ethics' },
  { id:'q299', text:'What is \'surveillance\' concern with AI?', options:['Excessive monitoring of people','Better spelling','Faster downloads','Cheaper hardware'], correctIndex:0, correctAnswer:'Excessive monitoring of people', why:'AI can enable pervasive tracking, raising civil-liberty concerns.', category:'ethics' },
  { id:'q300', text:'An AI \'safety\' goal is to…?', options:['Prevent harmful or unintended behavior','Increase font size','Reduce battery','Speed up boot time'], correctIndex:0, correctAnswer:'Prevent harmful or unintended behavior', why:'AI safety works to ensure systems behave as intended without harm.', category:'ethics' },
  { id:'q301', text:'Which improves user trust in AI?', options:['Clear communication of limitations','Hiding all errors','Overstating abilities','Refusing to explain'], correctIndex:0, correctAnswer:'Clear communication of limitations', why:'Being upfront about limits builds appropriate, calibrated trust.', category:'ethics' },
  { id:'q302', text:'\'Anonymization\' of data means…?', options:['Removing personal identifiers','Adding real names','Publishing addresses','Sharing phone numbers'], correctIndex:0, correctAnswer:'Removing personal identifiers', why:'Anonymization strips identifying details to protect privacy.', category:'ethics' },
  { id:'q303', text:'Automation may raise concerns about…?', options:['Job displacement','Better weather','Faster typing only','Louder speakers'], correctIndex:0, correctAnswer:'Job displacement', why:'Automation can displace some jobs, a major societal concern.', category:'ethics' },
  { id:'q304', text:'A \'harmful stereotype\' amplified by AI is a form of…?', options:['Bias','Compression','Encryption','Backup'], correctIndex:0, correctAnswer:'Bias', why:'Reinforcing stereotypes is a harmful form of AI bias.', category:'ethics' },
  { id:'q305', text:'Why should AI decisions in medicine be reviewed?', options:['Mistakes can seriously harm patients','Doctors are unnecessary','It saves paper','It looks modern'], correctIndex:0, correctAnswer:'Mistakes can seriously harm patients', why:'High-stakes medical decisions need human review to protect patients.', category:'ethics' },
  { id:'q306', text:'\'Consent to be recorded\' matters because…?', options:['It respects people\'s privacy rights','It improves audio','It saves storage','It speeds up AI'], correctIndex:0, correctAnswer:'It respects people\'s privacy rights', why:'Recording people without consent violates privacy and often the law.', category:'ethics' },
  { id:'q307', text:'What is a \'dual-use\' concern?', options:['Technology usable for both good and harm','A two-screen setup','A backup drive','A double password'], correctIndex:0, correctAnswer:'Technology usable for both good and harm', why:'Dual-use tech can benefit society or be misused for harm.', category:'ethics' },
  { id:'q308', text:'Responsible AI teams often include…?', options:['Ethicists and diverse perspectives','Only one engineer','No reviewers','Random strangers'], correctIndex:0, correctAnswer:'Ethicists and diverse perspectives', why:'Diverse teams help spot risks and blind spots in AI systems.', category:'ethics' },
  { id:'q309', text:'\'Right to explanation\' relates to…?', options:['Being told why an automated decision was made','Free hardware','Faster internet','Bigger screens'], correctIndex:0, correctAnswer:'Being told why an automated decision was made', why:'Some laws give people a right to an explanation of automated decisions.', category:'ethics' },
  { id:'q310', text:'A good use of AI at work is…?', options:['Drafting a first version of a document','Making all final decisions alone','Ignoring accuracy','Never checking output'], correctIndex:0, correctAnswer:'Drafting a first version of a document', why:'AI is great for first drafts that humans then review and refine.', category:'work' },
  { id:'q311', text:'Before sharing AI output at work, you should…?', options:['Fact-check and review it','Send it unread','Delete it','Ignore errors'], correctIndex:0, correctAnswer:'Fact-check and review it', why:'Always verify AI output for accuracy before relying on it.', category:'work' },
  { id:'q312', text:'AI can help summarize…?', options:['Long meeting notes','The weather outside','Your lunch','The room temperature'], correctIndex:0, correctAnswer:'Long meeting notes', why:'AI can condense lengthy notes into key points.', category:'work' },
  { id:'q313', text:'Which is a safe practice with company data and AI tools?', options:['Follow your organization\'s data policies','Paste secrets everywhere','Ignore all rules','Share passwords'], correctIndex:0, correctAnswer:'Follow your organization\'s data policies', why:'Always follow data-handling policies to protect confidential information.', category:'work' },
  { id:'q314', text:'AI writing assistants are best treated as…?', options:['A helpful collaborator you still review','A perfect oracle','A replacement for thinking','A random toy'], correctIndex:0, correctAnswer:'A helpful collaborator you still review', why:'Treat AI as an assistant whose work you verify, not an infallible source.', category:'work' },
  { id:'q315', text:'Using AI to brainstorm ideas is useful because it…?', options:['Quickly offers many options','Guarantees the best idea','Never repeats itself','Reads your mind'], correctIndex:0, correctAnswer:'Quickly offers many options', why:'AI can rapidly generate many ideas to spark your own thinking.', category:'work' },
  { id:'q316', text:'A risk of pasting confidential info into public AI tools is…?', options:['Data could be exposed','Faster typing','Better grammar','More storage'], correctIndex:0, correctAnswer:'Data could be exposed', why:'Sensitive data pasted into public tools may be stored or exposed.', category:'work' },
  { id:'q317', text:'AI can assist coding by…?', options:['Suggesting code and finding bugs','Buying a new laptop','Cleaning the desk','Making coffee'], correctIndex:0, correctAnswer:'Suggesting code and finding bugs', why:'AI coding tools suggest code, explain errors, and help debug.', category:'work' },
  { id:'q318', text:'When AI gives a citation, you should…?', options:['Verify the source actually exists','Trust it blindly','Ignore it','Delete it'], correctIndex:0, correctAnswer:'Verify the source actually exists', why:'AI can fabricate citations, so always confirm sources are real.', category:'work' },
  { id:'q319', text:'AI translation at work is helpful but…?', options:['May need human review for nuance','Is always perfect','Never makes errors','Replaces all translators'], correctIndex:0, correctAnswer:'May need human review for nuance', why:'Machine translation can miss nuance, so review important text.', category:'work' },
  { id:'q320', text:'A good prompt at work is usually…?', options:['Clear and specific about the goal','Vague and short','Full of typos','Missing context'], correctIndex:0, correctAnswer:'Clear and specific about the goal', why:'Clear, specific prompts with context get better results.', category:'work' },
  { id:'q321', text:'AI meeting transcription can…?', options:['Turn spoken meetings into text notes','Cook lunch','Fix the printer','Clean the office'], correctIndex:0, correctAnswer:'Turn spoken meetings into text notes', why:'Transcription tools convert meeting audio into searchable text.', category:'work' },
  { id:'q322', text:'Which is a limitation to communicate to a client about AI?', options:['It can make confident mistakes','It is always right','It never needs review','It reads minds'], correctIndex:0, correctAnswer:'It can make confident mistakes', why:'Be honest that AI can produce confident but incorrect output.', category:'work' },
  { id:'q323', text:'Automating a repetitive task with AI frees you to…?', options:['Focus on higher-value work','Stop working entirely','Ignore quality','Avoid learning'], correctIndex:0, correctAnswer:'Focus on higher-value work', why:'Automation can shift human effort toward more valuable, creative work.', category:'work' },
  { id:'q324', text:'A responsible way to use AI for emails is to…?', options:['Draft, then personalize and review','Send raw drafts instantly','Never read them','Copy secrets in'], correctIndex:0, correctAnswer:'Draft, then personalize and review', why:'Use AI drafts as a starting point, then personalize and check them.', category:'work' },
  { id:'q325', text:'AI-generated code should be…?', options:['Tested before shipping','Deployed untested','Deleted always','Ignored'], correctIndex:0, correctAnswer:'Tested before shipping', why:'Test AI-generated code just like any code before production.', category:'work' },
  { id:'q326', text:'Which helps teams adopt AI safely?', options:['Clear usage guidelines and training','No rules at all','Secret experiments','Ignoring risks'], correctIndex:0, correctAnswer:'Clear usage guidelines and training', why:'Guidelines and training help teams use AI responsibly and effectively.', category:'work' },
  { id:'q327', text:'AI can support customer service by…?', options:['Answering common questions quickly','Replacing all humans instantly','Ignoring complaints','Deleting tickets'], correctIndex:0, correctAnswer:'Answering common questions quickly', why:'AI handles routine queries so humans can focus on complex cases.', category:'work' },
  { id:'q328', text:'A benefit of AI note-taking is…?', options:['Freeing you to focus on the conversation','Louder audio','Cheaper laptops','Faster Wi-Fi'], correctIndex:0, correctAnswer:'Freeing you to focus on the conversation', why:'AI note-taking lets you engage more while it captures details.', category:'work' },
  { id:'q329', text:'Keeping a human reviewer for AI reports helps ensure…?', options:['Accuracy and appropriate tone','Slower delivery only','More errors','No accountability'], correctIndex:0, correctAnswer:'Accuracy and appropriate tone', why:'Human review catches errors and keeps tone and facts appropriate.', category:'work' },
  { id:'q330', text:'In predictive maintenance, AI predicts…?', options:['When equipment is likely to fail','Tomorrow\'s lottery','The stock market perfectly','Your mood'], correctIndex:0, correctAnswer:'When equipment is likely to fail', why:'Predictive maintenance forecasts equipment failures to schedule repairs early.', category:'applied' },
  { id:'q331', text:'A \'recommendation system\' is used by…?', options:['Streaming and shopping platforms','Only calculators','Only printers','Only fax machines'], correctIndex:0, correctAnswer:'Streaming and shopping platforms', why:'Recommenders (Netflix, Amazon) suggest items based on your behavior.', category:'applied' },
  { id:'q332', text:'AI \'anomaly detection\' finds…?', options:['Unusual patterns like fraud','The largest file','The screen size','The battery brand'], correctIndex:0, correctAnswer:'Unusual patterns like fraud', why:'Anomaly detection flags outliers such as fraudulent transactions.', category:'applied' },
  { id:'q333', text:'Autonomous vehicles combine AI with…?', options:['Sensors like cameras and LiDAR','Only a steering wheel','Only paper maps','Only a horn'], correctIndex:0, correctAnswer:'Sensors like cameras and LiDAR', why:'Self-driving cars fuse camera, LiDAR, and radar data with AI.', category:'applied' },
  { id:'q334', text:'AI in agriculture can help with…?', options:['Detecting crop diseases from images','Cooking dinner','Playing music','Cutting hair'], correctIndex:0, correctAnswer:'Detecting crop diseases from images', why:'AI vision can spot crop disease and monitor field health.', category:'applied' },
  { id:'q335', text:'A \'digital twin\' is…?', options:['A virtual model of a real system','An identical human','A backup password','A second monitor'], correctIndex:0, correctAnswer:'A virtual model of a real system', why:'A digital twin is a live virtual replica used to simulate and monitor a real asset.', category:'applied' },
  { id:'q336', text:'AI-based fraud detection watches for…?', options:['Suspicious transaction patterns','Bright screens','Loud sounds','Cold weather'], correctIndex:0, correctAnswer:'Suspicious transaction patterns', why:'Fraud detection models flag transactions that deviate from normal behavior.', category:'applied' },
  { id:'q337', text:'Sentiment analysis determines…?', options:['Whether text is positive or negative','The file size','The GPU model','The Wi-Fi speed'], correctIndex:0, correctAnswer:'Whether text is positive or negative', why:'Sentiment analysis classifies the emotional tone of text.', category:'applied' },
  { id:'q338', text:'In manufacturing, computer vision can…?', options:['Spot defects on a production line','Paint the walls','Pay salaries','Order lunch'], correctIndex:0, correctAnswer:'Spot defects on a production line', why:'Vision systems inspect products for defects automatically.', category:'applied' },
  { id:'q339', text:'A \'chatbot\' for banking can help customers…?', options:['Check balances and answer FAQs','Physically print money','Repair ATMs','Drive to the bank'], correctIndex:0, correctAnswer:'Check balances and answer FAQs', why:'Banking chatbots handle balance checks and common questions.', category:'applied' },
  { id:'q340', text:'AI in weather forecasting improves…?', options:['Prediction accuracy from large data','The taste of rain','The color of clouds','The sound of thunder'], correctIndex:0, correctAnswer:'Prediction accuracy from large data', why:'AI models learn from vast weather data to improve forecasts.', category:'applied' },
  { id:'q341', text:'Route optimization (like maps) uses AI to…?', options:['Find efficient paths and traffic-aware routes','Cook food','Print tickets','Charge phones'], correctIndex:0, correctAnswer:'Find efficient paths and traffic-aware routes', why:'AI optimizes routes using traffic and distance data.', category:'applied' },
  { id:'q342', text:'AI in energy grids can help…?', options:['Balance supply and demand','Bake bread','Cut grass','Wash cars'], correctIndex:0, correctAnswer:'Balance supply and demand', why:'AI forecasts demand and balances loads to stabilize energy grids.', category:'applied' },
  { id:'q343', text:'Speech-to-text captions help by…?', options:['Making audio accessible as text','Increasing volume','Changing languages of music','Cooling the CPU'], correctIndex:0, correctAnswer:'Making audio accessible as text', why:'Captions from speech-to-text improve accessibility for audio content.', category:'applied' },
  { id:'q344', text:'A \'knowledge base\' + AI assistant lets employees…?', options:['Quickly find answers from company docs','Physically build servers','Repair chairs','Water plants'], correctIndex:0, correctAnswer:'Quickly find answers from company docs', why:'AI over a knowledge base retrieves relevant company information fast.', category:'applied' },
  { id:'q345', text:'AI-powered inventory forecasting predicts…?', options:['Future demand for stock','The weather forever','Lottery numbers','Your dreams'], correctIndex:0, correctAnswer:'Future demand for stock', why:'Demand forecasting helps stores stock the right amount.', category:'applied' },
  { id:'q346', text:'Robotic process automation (RPA) handles…?', options:['Repetitive rule-based digital tasks','Deep philosophical debates','Creative painting','Emotional counseling'], correctIndex:0, correctAnswer:'Repetitive rule-based digital tasks', why:'RPA automates repetitive, rule-based software tasks like data entry.', category:'applied' },
  { id:'q347', text:'AI in education can provide…?', options:['Personalized learning suggestions','Free hardware','Faster buses','Cheaper food'], correctIndex:0, correctAnswer:'Personalized learning suggestions', why:'AI tutors adapt content to a learner\'s pace and needs.', category:'applied' },
  { id:'q348', text:'A vision model reading car number plates is doing…?', options:['Automatic number-plate recognition','Weather forecasting','Music generation','Password cracking'], correctIndex:0, correctAnswer:'Automatic number-plate recognition', why:'ANPR uses computer vision/OCR to read license plates.', category:'applied' },
  { id:'q349', text:'AI \'demand-based pricing\' adjusts prices using…?', options:['Real-time data and patterns','Random guesses only','The moon phase','Your shoe size'], correctIndex:0, correctAnswer:'Real-time data and patterns', why:'Dynamic pricing models set prices using demand and other signals.', category:'applied' },
  { id:'q350', text:'Which is an example of AI at the network \'edge\'?', options:['Face unlock running on the phone itself','A giant cloud-only model','A paper form','A landline phone'], correctIndex:0, correctAnswer:'Face unlock running on the phone itself', why:'Edge AI runs models directly on devices instead of the cloud.', category:'applied' },
  { id:'q351', text:'What is \'machine translation\'?', options:['Software translating between languages','Fixing engines','Building machines','Cleaning code'], correctIndex:0, correctAnswer:'Software translating between languages', why:'Machine translation automatically converts text between languages.', category:'basic' },
  { id:'q352', text:'A \'model\' in AI is…?', options:['A trained system that makes predictions','A fashion figure','A toy car','A screen type'], correctIndex:0, correctAnswer:'A trained system that makes predictions', why:'An AI model is the trained function that maps inputs to outputs.', category:'basic' },
  { id:'q353', text:'\'Inference\' in AI means…?', options:['Using a trained model to make predictions','Training from scratch','Deleting data','Buying hardware'], correctIndex:0, correctAnswer:'Using a trained model to make predictions', why:'Inference is running a trained model to produce outputs on new data.', category:'basic' },
  { id:'q354', text:'Which is a benefit of AI?', options:['Automating repetitive tasks','Guaranteeing zero errors','Removing all jobs instantly','Reading minds'], correctIndex:0, correctAnswer:'Automating repetitive tasks', why:'AI excels at automating repetitive tasks and analyzing large data.', category:'basic' },
  { id:'q355', text:'What is a \'prompt template\'?', options:['A reusable prompt structure with placeholders','A hardware part','A screen saver','A password'], correctIndex:0, correctAnswer:'A reusable prompt structure with placeholders', why:'Prompt templates provide a reusable structure you fill with specifics.', category:'basic' },
  { id:'q356', text:'\'Text data\' is an example of…?', options:['Unstructured data','A GPU','A cable','A monitor'], correctIndex:0, correctAnswer:'Unstructured data', why:'Free-form text is a common type of unstructured data.', category:'basic' },
  { id:'q357', text:'A \'weight\' in a neural network is…?', options:['A learned numeric strength of a connection','A physical mass','A file size','A password'], correctIndex:0, correctAnswer:'A learned numeric strength of a connection', why:'Weights are the learned numbers that determine a network\'s behavior.', category:'basic' },
  { id:'q358', text:'What is \'labeling data\' also called?', options:['Annotation','Compression','Encryption','Deletion'], correctIndex:0, correctAnswer:'Annotation', why:'Adding labels to data is known as annotation.', category:'basic' },
  { id:'q359', text:'Which best describes an \'AI agent\'?', options:['Software that perceives and acts to reach goals','A human employee','A printer','A monitor'], correctIndex:0, correctAnswer:'Software that perceives and acts to reach goals', why:'An AI agent senses its environment and takes actions toward goals.', category:'basic' },
  { id:'q360', text:'\'Big data\' refers to…?', options:['Very large, complex datasets','One small file','A big monitor','A loud speaker'], correctIndex:0, correctAnswer:'Very large, complex datasets', why:'Big data describes datasets too large or complex for traditional tools.', category:'basic' },
  { id:'q361', text:'What does \'CPU\' stand for?', options:['Central Processing Unit','Computer Personal Unit','Central Power Unit','Core Program Utility'], correctIndex:0, correctAnswer:'Central Processing Unit', why:'The CPU (Central Processing Unit) is the main processor of a computer.', category:'basic' },
  { id:'q362', text:'A \'database\' is used to…?', options:['Store and organize data','Cool the CPU','Display videos only','Charge phones'], correctIndex:0, correctAnswer:'Store and organize data', why:'A database stores structured data for easy access and management.', category:'basic' },
  { id:'q363', text:'What is \'edge computing\'?', options:['Processing data near where it\'s generated','Editing photo edges','A type of browser','A monitor stand'], correctIndex:0, correctAnswer:'Processing data near where it\'s generated', why:'Edge computing processes data locally on devices instead of a distant cloud.', category:'basic' },
  { id:'q364', text:'Which is an example of \'unstructured data\'?', options:['A social media post','A neat spreadsheet','A tidy database table','A sorted list of numbers'], correctIndex:0, correctAnswer:'A social media post', why:'Free-form text, images, and audio are unstructured data.', category:'basic' },
  { id:'q365', text:'What does \'ML model deployment\' mean?', options:['Making a model available for real use','Deleting the model','Printing the code','Buying a server rack'], correctIndex:0, correctAnswer:'Making a model available for real use', why:'Deployment puts a trained model into production so it can serve predictions.', category:'ml' },
  { id:'q366', text:'What is \'model drift\'?', options:['Performance degrading as real data changes','A GPU overheating','A screen tilting','A file moving folders'], correctIndex:0, correctAnswer:'Performance degrading as real data changes', why:'Model drift is when a model gets worse over time as data patterns shift.', category:'ml' },
  { id:'q367', text:'A \'validation set\' is used to…?', options:['Tune the model during development','Store passwords','Cool the laptop','Print reports'], correctIndex:0, correctAnswer:'Tune the model during development', why:'The validation set helps tune hyperparameters and check progress during training.', category:'ml' },
  { id:'q368', text:'\'Precision\' in classification measures…?', options:['How many predicted positives were correct','The screen sharpness','The CPU speed','The file size'], correctIndex:0, correctAnswer:'How many predicted positives were correct', why:'Precision is the fraction of predicted positives that are truly positive.', category:'ml' },
  { id:'q369', text:'\'Recall\' in classification measures…?', options:['How many actual positives were found','The audio volume','The battery level','The download speed'], correctIndex:0, correctAnswer:'How many actual positives were found', why:'Recall is the fraction of real positives the model correctly identified.', category:'ml' },
  { id:'q370', text:'The \'F1 score\' balances…?', options:['Precision and recall','Speed and storage','Color and brightness','Battery and Wi-Fi'], correctIndex:0, correctAnswer:'Precision and recall', why:'The F1 score is the harmonic mean of precision and recall.', category:'ml' },
  { id:'q371', text:'A \'random forest\' is made of many…?', options:['Decision trees','Real trees','Servers','Keyboards'], correctIndex:0, correctAnswer:'Decision trees', why:'A random forest combines many decision trees for stronger predictions.', category:'ml' },
  { id:'q372', text:'\'Regularization\' helps…?', options:['Reduce overfitting','Delete data','Speed up Wi-Fi','Brighten the screen'], correctIndex:0, correctAnswer:'Reduce overfitting', why:'Regularization penalizes complexity to help models generalize better.', category:'ml' },
  { id:'q373', text:'What is \'batch size\' in training?', options:['Number of samples processed before updating weights','The screen size','The battery capacity','The file count on disk'], correctIndex:0, correctAnswer:'Number of samples processed before updating weights', why:'Batch size is how many examples the model sees before each weight update.', category:'ml' },
  { id:'q374', text:'Which model type is common for image tasks?', options:['Convolutional Neural Network (CNN)','A spreadsheet','A calculator','A fax machine'], correctIndex:0, correctAnswer:'Convolutional Neural Network (CNN)', why:'CNNs are widely used for image recognition and computer vision.', category:'ml' },
  { id:'q375', text:'A \'transformer\' is especially good at…?', options:['Handling sequences like text','Frying food','Lifting weights','Cutting metal'], correctIndex:0, correctAnswer:'Handling sequences like text', why:'Transformers excel at sequence data such as language, powering modern LLMs.', category:'ml' },
  { id:'q376', text:'What is \'attention\' in a transformer?', options:['A mechanism to focus on relevant parts of input','A warning sound','A power button','A screen setting'], correctIndex:0, correctAnswer:'A mechanism to focus on relevant parts of input', why:'Attention lets the model weigh which input tokens matter most for each output.', category:'genai' },
  { id:'q377', text:'A \'prompt\' that assigns the AI a role (e.g. \'act as a teacher\') is called…?', options:['Role prompting','Data mining','Cold booting','Port forwarding'], correctIndex:0, correctAnswer:'Role prompting', why:'Role prompting sets a persona to steer the AI\'s tone and expertise.', category:'genai' },
  { id:'q378', text:'\'Zero-shot\' vs \'few-shot\' differ by…?', options:['Whether examples are given in the prompt','The screen size','The GPU brand','The battery type'], correctIndex:0, correctAnswer:'Whether examples are given in the prompt', why:'Zero-shot gives no examples; few-shot includes a few examples.', category:'genai' },
  { id:'q379', text:'An AI model returning made-up references is a form of…?', options:['Hallucination','Compression','Encryption','Caching'], correctIndex:0, correctAnswer:'Hallucination', why:'Fabricated citations are a classic hallucination failure mode.', category:'genai' },
  { id:'q380', text:'Which is an open-weights model family?', options:['Mistral','Notepad','Excel','Paint'], correctIndex:0, correctAnswer:'Mistral', why:'Mistral releases open-weight language models.', category:'genai' },
  { id:'q381', text:'\'Function calling\' lets an LLM…?', options:['Trigger external tools with structured output','Fry an egg','Change the wallpaper','Charge the phone'], correctIndex:0, correctAnswer:'Trigger external tools with structured output', why:'Function calling lets models invoke tools/APIs via structured requests.', category:'genai' },
  { id:'q382', text:'A \'context window\' being exceeded means…?', options:['Older text may be dropped or truncated','The screen turns off','The GPU melts','The Wi-Fi disconnects'], correctIndex:0, correctAnswer:'Older text may be dropped or truncated', why:'When input exceeds the context window, earlier tokens get cut off.', category:'genai' },
  { id:'q383', text:'\'Distillation\' of a model produces…?', options:['A smaller model mimicking a bigger one','A bigger, slower model','A deleted model','A printed model'], correctIndex:0, correctAnswer:'A smaller model mimicking a bigger one', why:'Distillation trains a compact \'student\' model to imitate a large \'teacher\'.', category:'genai' },
  { id:'q384', text:'Why disclose AI use in published content?', options:['Honesty and audience trust','To slow the site','To use more data','To change fonts'], correctIndex:0, correctAnswer:'Honesty and audience trust', why:'Disclosure supports transparency and honesty with the audience.', category:'ethics' },
  { id:'q385', text:'\'Differential privacy\' aims to…?', options:['Protect individuals in a dataset','Speed up the CPU','Brighten screens','Add more ads'], correctIndex:0, correctAnswer:'Protect individuals in a dataset', why:'Differential privacy adds noise so individuals can\'t be identified from data.', category:'ethics' },
  { id:'q386', text:'A risk of over-relying on AI is…?', options:['Skill loss and unchecked errors','Better handwriting','Faster walking','Louder music'], correctIndex:0, correctAnswer:'Skill loss and unchecked errors', why:'Over-reliance can erode skills and let mistakes slip through unchecked.', category:'ethics' },
  { id:'q387', text:'Why audit AI systems regularly?', options:['To catch bias and errors over time','To increase file size','To change the logo','To slow it down'], correctIndex:0, correctAnswer:'To catch bias and errors over time', why:'Regular audits help detect drift, bias, and emerging harms.', category:'ethics' },
  { id:'q388', text:'\'Content moderation\' AI must balance…?', options:['Safety with free expression','Screen size with color','Speed with weight','Battery with sound'], correctIndex:0, correctAnswer:'Safety with free expression', why:'Moderation systems must weigh removing harm against protecting expression.', category:'ethics' },
  { id:'q389', text:'A safe habit before trusting an AI answer at work is…?', options:['Cross-check with a reliable source','Assume it\'s always right','Delete your notes','Skip verification'], correctIndex:0, correctAnswer:'Cross-check with a reliable source', why:'Cross-checking guards against confident but wrong AI answers.', category:'work' },
  { id:'q390', text:'AI can help with data entry by…?', options:['Extracting fields from documents','Repairing the printer','Painting the office','Making tea'], correctIndex:0, correctAnswer:'Extracting fields from documents', why:'AI can read documents and extract structured fields automatically.', category:'work' },
  { id:'q391', text:'A prompt that includes the desired format (e.g. \'as a table\') tends to…?', options:['Produce more usable output','Break the model','Erase data','Slow the Wi-Fi'], correctIndex:0, correctAnswer:'Produce more usable output', why:'Specifying the output format helps you get directly usable results.', category:'work' },
